---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONTACT_EMAIL } from '../consts';
import { CONTACT_LIMITS } from '../utils/contactValidation';
import '../styles/editorial-pages.css';
const submissionId = crypto.randomUUID();
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="pl">
  <head><BaseHead title="Kontakt" description="Uwagi do tekstów, sprostowania i propozycje tematów. Napisz do Pseudointelektu." /></head>
  <body data-page-section="contact">
    <Header />
    <main class="editorial-page contact-page">
      <header class="editorial-heading">
        <h1>Kontakt</h1>
        <p>Uwagi do tekstu, sprostowanie, temat wart opisania — napisz.</p>
      </header>
      <div class="contact-layout">
        <section class="contact-copy" aria-labelledby="contact-direct">
          <h2 id="contact-direct">Do redakcji</h2>
          <a class="contact-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          <p>Możesz skorzystać z formularza albo wysłać e-mail. Przy uwagach do artykułu dodaj jego tytuł lub link. Jeśli proponujesz temat, przyda się źródło i kilka zdań kontekstu.</p>
          <p>Wiadomości nie są publikowane na stronie. Nie przesyłaj haseł ani innych poufnych danych.</p>
          <a class="text-link" href="/blog/">Wróć do artykułów →</a>
        </section>
        <section class="contact-form-section" aria-labelledby="form-title">
          <h2 id="form-title">Napisz wiadomość</h2>
          <form id="contact-form" action="/api/contact" method="post">
            <input type="hidden" name="submissionId" value={submissionId} />
            <div class="contact-trap" aria-hidden="true">
              <label>Twoja strona<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div class="contact-fields">
              <div><label for="contact-name">Imię lub podpis
                <input id="contact-name" name="name" type="text" maxlength={CONTACT_LIMITS.name} autocomplete="name" required aria-describedby="name-error" />
              </label>
                <span class="field-error" id="name-error"></span>
              </div>
              <div><label for="contact-email">Adres e-mail
                <input id="contact-email" name="email" type="email" maxlength={CONTACT_LIMITS.email} autocomplete="email" required aria-describedby="email-error" />
              </label>
                <span class="field-error" id="email-error"></span>
              </div>
            </div>
            <label for="contact-message">Wiadomość
              <textarea id="contact-message" name="message" rows="7" maxlength={CONTACT_LIMITS.message} required aria-describedby="message-error message-count"></textarea>
            </label>
            <span class="field-error" id="message-error"></span>
            <p class="message-count" id="message-count">0 / {CONTACT_LIMITS.message} znaków</p>
            <p class="privacy-note">Podane dane służą obsłudze korespondencji i ochronie przed nadużyciami. <a href="/privacy/">Jak przetwarzamy dane</a>.</p>
            <button type="submit" disabled>Wyślij wiadomość <span aria-hidden="true">↗</span></button>
            <p id="contact-status" class="contact-status" role="status" aria-live="polite" aria-atomic="true"></p>
            <noscript><p>Formularz wymaga JavaScript do obsługi potwierdzeń. Możesz też <a href={`mailto:${CONTACT_EMAIL}`}>napisać bezpośrednio e-mail</a>.</p></noscript>
          </form>
        </section>
      </div>
    </main>
    <Footer />
    <script>
      import { CONTACT_LIMITS, validateContact, type ContactFields } from '../utils/contactValidation';
      const form = document.querySelector<HTMLFormElement>('#contact-form');
      const status = document.querySelector<HTMLElement>('#contact-status');
      const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
      const submission = form?.querySelector<HTMLInputElement>('[name="submissionId"]');
      const counter = document.querySelector('#message-count');
      const message = form?.querySelector<HTMLTextAreaElement>('[name="message"]');
      let busy = false;
      let submittedPayload = '';
      const setStatus = (text: string, kind = '') => {
        if (status) { status.textContent = text; status.dataset.kind = kind; }
      };
      const fieldErrors = (errors: Partial<Record<keyof ContactFields, string>>) => {
        for (const key of ['name', 'email', 'message'] as const) {
          const input = form?.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${key}"]`);
          const hint = document.getElementById(`${key}-error`);
          if (input) input.setAttribute('aria-invalid', String(Boolean(errors[key])));
          if (hint) hint.textContent = errors[key] || '';
        }
      };
      const updateCount = () => { if (counter) counter.textContent = `${message?.value.length || 0} / ${CONTACT_LIMITS.message} znaków`; };
      message?.addEventListener('input', updateCount);
      form?.addEventListener('input', (event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) {
          target.removeAttribute('aria-invalid');
          const error = document.getElementById(`${target.name}-error`);
          if (error) error.textContent = '';
        }
      });
      if (form && button && submission) {
        button.disabled = false;
        form.noValidate = true;
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (busy) return;
          const data = new FormData(form);
          const fields = Object.fromEntries(['name', 'email', 'message'].map(key => [key, String(data.get(key) || '').trim()])) as ContactFields;
          const errors = validateContact(fields);
          fieldErrors(errors);
          if (Object.keys(errors).length) {
            setStatus('Sprawdź zaznaczone pola.', 'error');
            form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
            return;
          }
          const payload = JSON.stringify(fields);
          if (submittedPayload && submittedPayload !== payload) submission.value = crypto.randomUUID();
          submittedPayload = payload;
          data.set('submissionId', submission.value);
          busy = true;
          button.disabled = true;
          // Keep the submitted draft unchanged until receipt is known.
          for (const input of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type="hidden"]), textarea')) input.readOnly = true;
          form.setAttribute('aria-busy', 'true');
          button.textContent = 'Wysyłanie…';
          setStatus('Wysyłanie wiadomości…');
          try {
            const response = await fetch('/api/contact', { method: 'POST', body: data, headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(15000) });
            const result = await response.json();
            if (response.ok) {
              form.reset(); submission.value = crypto.randomUUID(); submittedPayload = ''; updateCount();
              setStatus('Dziękuję. Wiadomość została przyjęta.', 'success');
            } else {
              if (result.errors) fieldErrors(result.errors);
              setStatus(typeof result.message === 'string' ? result.message : 'Nie udało się wysłać wiadomości. Treść pozostaje w formularzu.', 'error');
              form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
            }
          } catch {
            setStatus('Nie udało się potwierdzić wysyłki. Treść pozostaje w formularzu — możesz bezpiecznie spróbować ponownie.', 'error');
          } finally {
            busy = false; button.disabled = false; button.textContent = 'Wyślij wiadomość ↗';
            form.removeAttribute('aria-busy');
            for (const input of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type="hidden"]), textarea')) input.readOnly = false;
          }
        });
      }
    </script>
  </body>
</html>
