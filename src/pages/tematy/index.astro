---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { buildTopicIndex, sortPostsByDate } from '../../utils/topics';
import '../../styles/editorial-pages.css';
const topics = buildTopicIndex(sortPostsByDate(await getCollection('blog')));
---
<!doctype html>
<html lang="pl">
  <head><BaseHead title={`Tematy | ${SITE_TITLE}`} description="Geopolityka, technologia, Europa, gospodarka i media — artykuły Pseudointelektu uporządkowane według tematów." /></head>
  <body data-page-section="topics">
    <Header />
    <main class="editorial-page">
      <header class="editorial-heading">
        <h1>Tematy</h1>
        <p>Pięć obszarów, w których opisujemy politykę i jej skutki. Wybierz temat, żeby przeczytać najnowsze teksty i wrócić do wcześniejszych analiz.</p>
        <a class="text-link" href="/blog/">Wszystkie artykuły według daty →</a>
      </header>
      <section class="topic-directory" aria-label="Wybierz temat">
        {topics.map((topic, index) => {
          const latest = topic.posts[0];
          return <a class="topic-entry" href={`/tematy/${topic.slug}/`}>
            <span class="topic-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="topic-summary"><h2>{topic.name}</h2><p>{topic.description}</p><span class="topic-total">Teksty: {topic.posts.length}</span></div>
            {latest && <div class="topic-recent"><span>Ostatnio · <FormattedDate date={latest.data.pubDate} /></span><p>{latest.data.title}</p></div>}
            <span class="topic-arrow" aria-hidden="true">↗</span>
          </a>;
        })}
      </section>
    </main>
    <Footer />
  </body>
</html>
