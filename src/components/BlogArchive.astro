---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import Pagination from './Pagination.astro';
import { TOPICS, inferPostTopics } from '../utils/topics';
import '../styles/editorial-pages.css';

type Post = CollectionEntry<'blog'>;
interface Props { posts: Post[]; page: number; perPage: number; }
const { posts, page, perPage } = Astro.props as Props;
const [featuredPost, ...archivePosts] = posts;
const totalPages = Math.max(1, Math.ceil(archivePosts.length / perPage));
const currentPage = Math.min(Math.max(page, 1), totalPages);
const pagePosts = archivePosts.slice((currentPage - 1) * perPage, currentPage * perPage);
const topicName = (post: Post) => inferPostTopics(post)[0]?.name || 'Analiza';
const records = posts.map((post) => ({
  id: post.id, title: post.data.title, description: post.data.description, tags: inferPostTopics(post).map(topic => topic.slug), topicLabel: topicName(post),
  image: post.data.heroImage, date: post.data.pubDate.toISOString(),
}));
const hrefForPage = (target: number) => target === 1 ? '/blog/' : `/blog/${target}/`;
---

<main class="blog-page">
  <header class="blog-intro editorial-heading" aria-labelledby="blog-title">
    <h1 id="blog-title">Archiwum analiz</h1>
    <p>Wszystkie teksty, od najnowszych. Znajdź konkretny artykuł albo wybierz temat, który Cię interesuje.</p>
    <div class="blog-tools">
      <label for="blog-search">Szukaj artykułu
        <input id="blog-search" class="blog-search" type="search" placeholder="Tytuł lub zagadnienie…" autocomplete="off" aria-controls="archive-results" />
      </label>
      <label for="blog-topic">Temat
        <select id="blog-topic" aria-controls="archive-results">
          <option value="">Wszystkie tematy</option>
          {TOPICS.map(topic => <option value={topic.slug}>{topic.name}</option>)}
        </select>
      </label>
    </div>
    <div class="archive-summary"><p class="blog-count" data-blog-count role="status" aria-live="polite">Teksty w archiwum: {posts.length}</p><button class="clear-search" type="button" data-clear-search hidden>Wyczyść filtry</button></div>
    <noscript><p>Wyszukiwanie wymaga JavaScript. Możesz przeglądać artykuły poniżej lub <a href="/tematy/">wybrać temat na osobnej stronie</a>.</p></noscript>
  </header>

  <div data-default-archive>
    {currentPage === 1 && featuredPost && (
      <section class="featured" aria-label="Najnowszy materiał">
        <a class="featured-link" href={`/blog/${featuredPost.id}/`}>
          <div class="featured-media">{featuredPost.data.heroImage && <img width="960" height="540" src={featuredPost.data.heroImage} alt="" loading="eager" />}</div>
          <div class="featured-body"><p class="post-meta"><span class="marker">Najnowsza analiza</span><span>{topicName(featuredPost)}</span><span><FormattedDate date={featuredPost.data.pubDate} /></span></p><h2>{featuredPost.data.title}</h2><p>{featuredPost.data.description}</p></div>
        </a>
      </section>
    )}
    <section aria-label={`Archiwum, strona ${currentPage}`}>
      <ul class="post-list">
        {pagePosts.map((post) => <li class="post-card"><a href={`/blog/${post.id}/`}><div class="post-card-media">{post.data.heroImage && <img width="720" height="480" src={post.data.heroImage} alt="" loading="lazy" />}</div><div class="post-card-body"><p class="post-meta"><span>{topicName(post)}</span><span><FormattedDate date={post.data.pubDate} /></span></p><h2>{post.data.title}</h2><p>{post.data.description}</p></div></a></li>)}
      </ul>
      <Pagination currentPage={currentPage} totalPages={totalPages} hrefForPage={hrefForPage} label="Strony archiwum" />
    </section>
  </div>

  <section id="archive-results" class="search-results" hidden data-search-results>
    <header><div><h2 data-results-title tabindex="-1">Wyniki wyszukiwania</h2></div><p data-results-count></p></header>
    <ul class="post-list" data-results-list></ul>
    <nav class="pagination" aria-label="Strony wyników" data-results-pagination></nav>
    <p class="empty-results" data-empty-results hidden>Nie znaleźliśmy materiałów dla tego zapytania. Spróbuj krótszej frazy lub innego tematu.</p>
  </section>
</main>

<script define:vars={{ records, perPage }}>
  const search = document.querySelector('#blog-search');
  const topicSelect = document.querySelector('#blog-topic');
  const defaultArchive = document.querySelector('[data-default-archive]');
  const results = document.querySelector('[data-search-results]');
  const list = document.querySelector('[data-results-list]');
  const pagination = document.querySelector('[data-results-pagination]');
  const count = document.querySelector('[data-results-count]');
  const empty = document.querySelector('[data-empty-results]');
  const clear = document.querySelector('[data-clear-search]');
  const normalCount = document.querySelector('[data-blog-count]');
  let activeTopic = new URLSearchParams(location.search).get('temat') || '';
  if (!(topicSelect instanceof HTMLSelectElement) || !Array.from(topicSelect.options).some(option => option.value === activeTopic)) activeTopic = '';
  let resultPage = 1;
  let timer = 0;
  let lastQuery = '';
  if (search instanceof HTMLInputElement) search.value = new URLSearchParams(location.search).get('q') || '';

  function card(post) {
    const item = document.createElement('li'); item.className = 'post-card';
    const link = document.createElement('a'); link.href = `/blog/${post.id}/`;
    const media = document.createElement('div'); media.className = 'post-card-media';
    if (post.image) { const image = document.createElement('img'); image.src = post.image; image.alt = ''; image.loading = 'lazy'; media.append(image); }
    const body = document.createElement('div'); body.className = 'post-card-body';
    const meta = document.createElement('p'); meta.className = 'post-meta';
    const tag = document.createElement('span'); tag.textContent = post.topicLabel;
    const date = document.createElement('span'); date.textContent = new Intl.DateTimeFormat('pl-PL', { day:'2-digit', month:'long', year:'numeric' }).format(new Date(post.date));
    meta.append(tag, date);
    const title = document.createElement('h2'); title.textContent = post.title;
    const description = document.createElement('p'); description.textContent = post.description;
    body.append(meta, title, description); link.append(media, body); item.append(link); return item;
  }
  function setFilters() { if (topicSelect instanceof HTMLSelectElement) topicSelect.value = activeTopic; }
  const normalize = text => text.toLocaleLowerCase('pl-PL').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replaceAll('ł', 'l');
  function updateUrl(query) { const params = new URLSearchParams(); if (query) params.set('q', query); if (activeTopic) params.set('temat', activeTopic); history.replaceState({}, '', `${location.pathname}${params.size ? `?${params}` : ''}`); }
  function render(targetPage = 1) {
    const query = search instanceof HTMLInputElement ? search.value.trim().toLocaleLowerCase('pl-PL') : '';
    const filtered = records.filter((post) => (!query || normalize(`${post.title} ${post.description} ${post.topicLabel} ${post.tags.join(' ')}`).includes(normalize(query))) && (!activeTopic || post.tags.includes(activeTopic)));
    const active = Boolean(query || activeTopic); resultPage = targetPage;
    if (defaultArchive) defaultArchive.hidden = active;
    if (results) results.hidden = !active;
    if (clear instanceof HTMLButtonElement) clear.hidden = !active;
    if (normalCount) normalCount.textContent = active ? `Znaleziono: ${filtered.length} z ${records.length}` : `Teksty w archiwum: ${records.length}`;
    updateUrl(query); setFilters(); clearTimeout(timer);
    if (!active || !list || !pagination || !count || !empty) return;
    const pages = Math.max(1, Math.ceil(filtered.length / perPage)); resultPage = Math.min(resultPage, pages);
    list.replaceChildren(...filtered.slice((resultPage - 1) * perPage, resultPage * perPage).map(card));
    count.textContent = `Strona ${resultPage} z ${pages}`;
    empty.hidden = filtered.length !== 0;
    pagination.replaceChildren();
    if (pages > 1) {
      const addControl = (label, page, disabled = false) => { const button = document.createElement('button'); button.type = 'button'; button.className = 'pagination-control'; button.textContent = label; button.disabled = disabled; button.addEventListener('click', () => { render(page); document.querySelector('[data-results-title]')?.focus(); }); pagination.append(button); };
      addControl('← Nowsze', resultPage - 1, resultPage === 1);
      const numbers = document.createElement('ol');
      for (let number = 1; number <= pages; number += 1) { const item = document.createElement('li'); const button = document.createElement('button'); button.type = 'button'; button.className = 'pagination-number'; button.textContent = String(number); button.setAttribute('aria-label', `Strona wyników ${number}`); if (number === resultPage) button.setAttribute('aria-current', 'page'); button.addEventListener('click', () => { render(number); document.querySelector('[data-results-title]')?.focus(); }); item.append(button); numbers.append(item); }
      pagination.append(numbers);
      addControl('Starsze →', resultPage + 1, resultPage === pages);
    }
    clearTimeout(timer); if (query.length >= 2 && query !== lastQuery) { timer = setTimeout(() => { lastQuery = query; window.pseudointelektTrack?.('blog_search', { query_length: query.length, result_count: filtered.length, topic: activeTopic || 'all', result_page: resultPage }); }, 500); }
  }
  topicSelect?.addEventListener('change', () => { activeTopic = topicSelect.value; render(); });
  search?.addEventListener('input', () => render());
  clear?.addEventListener('click', () => { if (search instanceof HTMLInputElement) search.value = ''; activeTopic = ''; render(); search?.focus(); });
  setFilters(); render();
</script>

<style is:global>
  .blog-page .featured { margin:2.25rem 0; } .blog-page .featured-link { display:grid; grid-template-columns:minmax(280px,.9fr) minmax(0,1.1fr); overflow:hidden; border:1px solid rgba(224,202,118,.22); border-radius:0; color:inherit; background:rgba(7,43,33,.8); text-decoration:none; }
  .blog-page .featured-media,.blog-page .post-card-media { aspect-ratio:3/2; background:#0b3329; } .blog-page .featured-media img,.blog-page .post-card-media img { display:block; width:100%; height:100%; object-fit:cover; filter:saturate(.84) contrast(1.04); }
  .blog-page .featured-body { display:grid; align-content:center; gap:.9rem; padding:clamp(1.35rem,3vw,2.25rem); }.blog-page .post-meta { display:flex; flex-wrap:wrap; gap:.5rem .75rem; margin:0; color:var(--gold-accent); font-size:.74rem; font-weight:700; letter-spacing:.05em; line-height:1.35; text-transform:uppercase; }.blog-page .post-meta span + span::before { content:'·'; margin-right:.75rem; color:rgba(241,238,229,.38); }.blog-page .marker{color:var(--gold-accent)}.blog-page .featured h2{margin:0;color:var(--ivory);font-size:clamp(1.8rem,3.5vw,3rem);line-height:1.05}.blog-page .featured p:last-child,.blog-page .post-card-body>p:last-child{margin:0;color:rgba(241,238,229,.72);font-size:.94rem;line-height:1.55}
  .blog-page .post-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:0;padding:0;list-style:none}.blog-page .post-card a{display:grid;height:100%;overflow:hidden;border:1px solid rgba(224,202,118,.18);border-radius:0;color:inherit;background:rgba(7,43,33,.78);text-decoration:none}.blog-page .post-card-body{display:grid;align-content:start;gap:.8rem;padding:1.15rem;background:rgba(5,37,29,.97)}.blog-page .post-card h2{margin:0;color:var(--ivory);font-size:clamp(1.15rem,2.1vw,1.42rem);line-height:1.16}.blog-page .post-card a:hover,.blog-page .post-card a:focus-visible,.blog-page .featured-link:hover,.blog-page .featured-link:focus-visible{border-color:var(--gold-accent);outline:2px solid var(--gold-accent);outline-offset:3px}
  .blog-page .search-results{padding-top:2.5rem}.blog-page .search-results header{display:flex;align-items:end;justify-content:space-between;gap:1.25rem;margin-bottom:1.35rem;padding-bottom:1.1rem;border-bottom:1px solid rgba(224,202,118,.18)}.blog-page .search-results h2{font-size:clamp(2rem,4vw,3.5rem)}.blog-page .search-results header>p:last-child{margin:0;color:rgba(241,238,229,.76);font-size:.86rem;line-height:1.3}.blog-page .empty-results{margin:1.25rem 0 0;padding:1.1rem;border:1px dashed rgba(224,202,118,.35);border-radius:10px;color:rgba(241,238,229,.75)}
  .blog-page .pagination{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:2.2rem 0 0;padding-top:1.25rem;border-top:1px solid rgba(224,202,118,.22);font-size:.84rem}.blog-page .pagination ol{display:flex;flex-wrap:wrap;justify-content:center;gap:.4rem;margin:0;padding:0;list-style:none}.blog-page .pagination a,.blog-page .pagination button{display:grid;place-items:center;min-width:2.5rem;min-height:2.5rem;padding:.4rem .65rem;border:1px solid rgba(224,202,118,.22);border-radius:0;background:rgba(3,29,22,.45);color:rgba(241,238,229,.82);font:inherit;font-weight:700;line-height:1;cursor:pointer;text-decoration:none}.blog-page .pagination>a,.blog-page .pagination>span,.blog-page .pagination .pagination-control{min-width:6.4rem}.blog-page .pagination>a:last-child,.blog-page .pagination>span:last-child{text-align:right}.blog-page .pagination>span{display:grid;place-items:center;min-width:6.4rem;min-height:2.5rem;color:rgba(241,238,229,.35)}.blog-page .pagination a:hover,.blog-page .pagination a:focus-visible,.blog-page .pagination button:hover:not(:disabled),.blog-page .pagination button:focus-visible,.blog-page .pagination a[aria-current=page],.blog-page .pagination button[aria-current=page]{border-color:var(--gold-accent);background:var(--gold-accent);color:#072b21;outline:none}.blog-page .pagination button:disabled{opacity:.36;cursor:not-allowed}.blog-page [data-results-pagination]{justify-content:center}.blog-page [data-results-pagination] .pagination-control:first-child{justify-self:start}.blog-page [data-results-pagination] .pagination-control:last-child{justify-self:end}

  .blog-page .blog-tools{display:grid;grid-template-columns:minmax(0,2fr) minmax(220px,1fr);gap:1.25rem;margin:2rem 0 1rem}
  .blog-page .blog-tools label{display:grid;gap:.65rem;color:var(--ivory);font-size:.85rem}
  .blog-page .blog-tools :is(input,select){box-sizing:border-box;width:100%;min-height:52px;padding:.75rem .9rem;border:1px solid #d9b53e55;background:#0a2a21;color:var(--ivory);font:inherit;font-size:1rem;color-scheme:dark}
  .blog-page .blog-tools :is(input,select):focus-visible,.blog-page .clear-search:focus-visible{outline:2px solid var(--gold-accent);outline-offset:4px}
  .blog-page .archive-summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:44px}
  .blog-page .blog-count{margin:0;color:#f1eee5b8;font-size:.85rem}
  .blog-page .clear-search{padding:.6rem 0;min-height:44px;border:0;background:transparent;color:var(--gold-accent);font:inherit;font-size:.85rem;text-decoration:underline;text-underline-offset:.2em;cursor:pointer}
  .blog-page .search-results h2{margin:0;font-size:clamp(1.6rem,4vw,2.2rem);line-height:1.1}
  .blog-page .featured-link,.blog-page .post-card a{transition:border-color 160ms}
  .blog-page [hidden]{display:none!important}
  @media(max-width:800px){.blog-page .featured-link{grid-template-columns:1fr}.blog-page .featured-media{max-height:390px}}
  @media(max-width:620px){.blog-page .blog-tools,.blog-page .post-list{grid-template-columns:1fr}.blog-page .search-results header{display:grid}.blog-page .archive-summary{align-items:start}.blog-page .pagination{flex-wrap:wrap;gap:.65rem}.blog-page .pagination ol{order:3;flex-basis:100%}.blog-page .pagination a,.blog-page .pagination button{min-height:44px}}
</style>
