---
import type { TopicSummary } from '../utils/topics';
import FormattedDate from './FormattedDate.astro';
import Pagination from './Pagination.astro';
import '../styles/editorial-pages.css';
interface Props { topic: TopicSummary; page: number; perPage: number; }
const { topic, page, perPage } = Astro.props as Props;
const totalPages = Math.max(1, Math.ceil(topic.posts.length / perPage));
const currentPage = Math.min(Math.max(page, 1), totalPages);
const posts = topic.posts.slice((currentPage - 1) * perPage, currentPage * perPage);
const hrefForPage = (target: number) => target === 1 ? `/tematy/${topic.slug}/` : `/tematy/${topic.slug}/${target}/`;
---
<main class="dossier-page editorial-page">
  <section class="dossier-hero editorial-heading" aria-labelledby="topic-title"><div><a href="/tematy/">← Wszystkie tematy</a><h1 id="topic-title">{topic.name}</h1><p>{topic.lens}</p></div><p class="dossier-total">Teksty: {topic.posts.length}</p></section>
  <div class="dossier-content"><section aria-label={`Materiały: ${topic.name}`}><p class="list-label">Materiały · strona {currentPage} z {totalPages}</p><ul class="dossier-list">{posts.map((post) => <li><a href={`/blog/${post.id}/`}><div>{post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" />}</div><article><span class="post-date"><FormattedDate date={post.data.pubDate} /></span><h2>{post.data.title}</h2><p>{post.data.description}</p></article></a></li>)}</ul><Pagination currentPage={currentPage} totalPages={totalPages} hrefForPage={hrefForPage} label={`Strony dossier ${topic.name}`} /></section><aside><h2>Co śledzimy</h2><p>{topic.context}</p><a href="/blog/">Przejdź do pełnego archiwum →</a></aside></div>
</main>
<style>
 .dossier-page{width:min(1180px,calc(100% - 4rem));max-width:none;padding:0 0 clamp(4rem,7vw,6rem);color:var(--ivory)}.dossier-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(1.5rem,5vw,4rem);align-items:end;padding:clamp(3rem,7vw,5.5rem) 0 2.5rem;border-bottom:1px solid rgba(224,202,118,.2)}.dossier-hero>a,.dossier-hero div>a{display:inline-flex;margin-bottom:1.2rem;color:var(--gold-accent);font-size:.88rem;font-weight:700;text-decoration:none}.dossier-hero h1{margin:0;color:var(--ivory);font-size:clamp(2.8rem,6vw,5.2rem);line-height:.94}.dossier-hero>div>p:last-child{max-width:56ch;margin:1rem 0 0;color:rgba(241,238,229,.75);line-height:1.55}.dossier-content{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:clamp(1.5rem,4vw,3rem);padding-top:2rem}.list-label{margin:0 0 .8rem;color:rgba(241,238,229,.62);font-size:.83rem}.dossier-list{display:grid;gap:.8rem;margin:0;padding:0;list-style:none}.dossier-list a{display:grid;grid-template-columns:190px minmax(0,1fr);overflow:hidden;border:1px solid rgba(224,202,118,.18);color:inherit;background:rgba(7,43,33,.76);text-decoration:none}.dossier-list a>div{min-height:150px;background:#0b3329}.dossier-list img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.84) contrast(1.04)}.dossier-list article{padding:1rem 1.1rem}.dossier-list .post-date{color:var(--gold-accent);font-size:.74rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.dossier-list h2{margin:.45rem 0;color:var(--ivory);font-size:clamp(1.2rem,2vw,1.55rem);line-height:1.12}.dossier-list p{margin:0;color:rgba(241,238,229,.72);font-size:.92rem;line-height:1.5}.dossier-list a:hover,.dossier-list a:focus-visible{border-color:var(--gold-accent);outline:2px solid var(--gold-accent);outline-offset:3px}aside{align-self:start;padding:0 0 0 1.5rem;border-left:1px solid rgba(224,202,118,.2)}aside h2{margin:0;color:var(--ivory);font-size:1.35rem}aside p{margin:.75rem 0 1rem;color:rgba(241,238,229,.72);font-size:.92rem;line-height:1.55}aside a{color:var(--gold-accent);font-size:.88rem;font-weight:700}@media(max-width:760px){.dossier-hero,.dossier-content{grid-template-columns:1fr}.dossier-content aside{position:static}.dossier-list a{grid-template-columns:1fr}.dossier-list a>div{aspect-ratio:3/2;min-height:0}}@media(max-width:520px){.dossier-page{width:calc(100% - 2.5rem)}}
.dossier-total{margin:0;color:#f1eee5a6;font-size:.9rem;white-space:nowrap}.dossier-page .dossier-hero h1{font-size:clamp(2.8rem,6vw,5rem);line-height:1.04}.dossier-hero a:focus-visible{outline:2px solid var(--gold-accent);outline-offset:4px}@media(max-width:760px){.dossier-content aside{padding:1.5rem 0 0;border-left:0;border-top:1px solid #d9b53e30}}
</style>
